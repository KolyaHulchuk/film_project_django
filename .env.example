# Django
SECRET_KEY=changeme
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Database (parsed with dj_database_url; omit/leave unset to fall back to local db.sqlite3)
DATABASE_URL=postgres://user:password@localhost:5432/film_project

# TMDB API
TMDB_API_KEY=your_tmdb_api_key

# Groq API (AI recommendation assistant)
GROQ_API_KEY=your_groq_api_key

# Redis (Celery broker/result backend + TMDB list/item cache)
REDIS_URL=redis://localhost:6379/0

# Gmail SMTP (password reset emails)
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password

# Google OAuth (django-allauth social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Logging (stdout). INFO by default; DEBUG adds catalog timings and Redis cache hits/misses.
LOG_LEVEL=INFO

# Comma-separated emails that get a mail for every unhandled 500 while DEBUG=False (sent via the Gmail SMTP above).
ADMINS=

# Header with the real client IP (brute-force lockout, rate limits, security log). Render's
# Cloudflare layer sets CF-Connecting-IP; leave empty to always use REMOTE_ADDR.
CLIENT_IP_HEADER=CF-Connecting-IP
